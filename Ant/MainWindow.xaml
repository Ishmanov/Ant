<Window x:Class="Ant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ant"
        mc:Ignorable="d"
        Title="MainWindow" Height="800" Width="1600">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid Margin="10" SizeChanged="Field_SizeChanged">
            <!-- поле -->
            <UniformGrid x:Name="MyGrid"/>

            <!-- Слой с муравьем поверх сетки: муравей — один элемент, который плавно двигается и поворачивается -->
            <Canvas x:Name="AntLayer" IsHitTestVisible="False">
                <Polygon x:Name="AntShape" Points="0.5,0 1,1 0,1" Stretch="Fill" Fill="Red"
                         Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                    <Polygon.RenderTransform>
                        <TransformGroup>
                            <RotateTransform x:Name="AntRotate"/>
                            <TranslateTransform x:Name="AntMove"/>
                        </TransformGroup>
                    </Polygon.RenderTransform>
                </Polygon>
            </Canvas>
        </Grid>

        <Grid Grid.Column="1" Margin="10">
            <!-- настройки -->
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="6*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <!-- кнопки -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Button Content="Сгенерировать" Padding="40 20" Margin="50 0" Click="Generate"/>
                    <Button x:Name="StartButton" Content="Запустить" Padding="40 20" Margin="50 0" Click="Start"/>
                    <Button x:Name="PauseButton" Content="Пауза" Padding="40 20" Margin="50 0" Click="Stop"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <!-- размер поля, шанс покраски -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Размер поля:" Padding="0 5"/>
                    <TextBox x:Name="RowsBlock" Text="20" Padding="20 5" Margin="10 0" MaxLength="2"/>
                    <TextBlock Text="X" Padding="0 5"/>
                    <TextBox x:Name="ColumnsBlock" Text="20" Padding="20 5" Margin="10 0" MaxLength="2"/>
                    <TextBlock Text="Шанс покраски клетки:" Margin="20 0 0 0" Padding="0 5"/>
                    <TextBox x:Name="ChanceBlock" Text="50" Padding="20 5" Margin="10 0 5 0" MaxLength="3"/>
                    <TextBlock Text="%" Padding="0 5"/>
                    <TextBlock Text="Задержка шага:" Margin="20 0 0 0" Padding="0 5"/>
                    <TextBlock x:Name="SpeedLabel" Text="100 мс" Padding="0 5"/>
                    <Slider x:Name="SpeedSlider" Minimum="10" Maximum="300" Value="100" IsSnapToTickEnabled="True" TickFrequency="10" ValueChanged="SpeedSlider_ValueChanged" MinWidth="100" Margin="0 5"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <!-- правила -->
                <StackPanel>
                    <!-- Палитра доступных действий -->
                    <WrapPanel>
                        <Border Tag="Flip" Background="LightGray" Padding="10" Margin="5" Cursor="Hand" MouseMove="ActionBlock_MouseMove">
                            <TextBlock Text="Перекрасить"/>
                        </Border>
                        <Border Tag="Right" Background="LightGray" Padding="10" Margin="5" Cursor="Hand" MouseMove="ActionBlock_MouseMove">
                            <TextBlock Text="Направо"/>
                        </Border>
                        <Border Tag="Left" Background="LightGray" Padding="10" Margin="5" Cursor="Hand" MouseMove="ActionBlock_MouseMove">
                            <TextBlock Text="Налево"/>
                        </Border>
                        <Border Tag="Go" Background="LightGray" Padding="10" Margin="5" Cursor="Hand" MouseMove="ActionBlock_MouseMove">
                            <TextBlock Text="Идти прямо"/>
                        </Border>
                    </WrapPanel>

                    <TextBlock Text="Если клетка белая (ПКМ по блоку — удалить):"/>
                    <Border Background="AliceBlue" MinHeight="150">
                        <StackPanel x:Name="WhiteRulesPanel" AllowDrop="True" Drop="RulesPanel_Drop" Background="Transparent"/>
                    </Border>

                    <TextBlock Text="Если клетка черная (ПКМ по блоку — удалить):"/>
                    <Border Background="AliceBlue" MinHeight="150">
                        <StackPanel x:Name="BlackRulesPanel" AllowDrop="True" Drop="RulesPanel_Drop" Background="Transparent"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
